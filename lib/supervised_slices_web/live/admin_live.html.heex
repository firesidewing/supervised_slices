<aside class="h-screen w-72 fixed left-0 top-0 bg-surface-container-low flex flex-col py-8 gap-2 z-40">
  <div class="px-6 pb-4">
    <%= if @org.logo_url do %>
      <img src={@org.logo_url} alt={@org.name} class="h-10 max-w-full object-contain mb-1" />
    <% else %>
      <div class="font-headline text-xl font-black text-primary italic">
        Kitchen Command
      </div>
    <% end %>
    <div class="font-body text-xs text-on-surface-variant mt-0.5">
      {@org.name}
    </div>
  </div>

  <nav class="flex flex-col gap-1 px-4">
    <.link
      navigate={~p"/kitchen/#{@org.slug}"}
      class={[
        "flex items-center gap-4 px-6 py-4 rounded-2xl font-medium transition-all duration-200 font-headline",
        if(@live_action == :orders,
          do: "bg-white text-primary shadow-sm",
          else: "text-on-surface-variant hover:bg-surface-container hover:translate-x-0.5"
        )
      ]}
    >
      <span class="material-symbols-outlined">pending_actions</span>
      <span>Live Orders</span>
    </.link>

    <.link
      navigate={~p"/kitchen/#{@org.slug}/baskets"}
      class={[
        "flex items-center gap-4 px-6 py-4 rounded-2xl font-medium transition-all duration-200 font-headline",
        if(@live_action == :baskets,
          do: "bg-white text-primary shadow-sm",
          else: "text-on-surface-variant hover:bg-surface-container hover:translate-x-0.5"
        )
      ]}
    >
      <span class="material-symbols-outlined">shopping_cart_checkout</span>
      <span>Basket Monitor</span>
    </.link>

    <.link
      navigate={~p"/kitchen/#{@org.slug}/history"}
      class={[
        "flex items-center gap-4 px-6 py-4 rounded-2xl font-medium transition-all duration-200 font-headline",
        if(@live_action == :history,
          do: "bg-white text-primary shadow-sm",
          else: "text-on-surface-variant hover:bg-surface-container hover:translate-x-0.5"
        )
      ]}
    >
      <span class="material-symbols-outlined">history</span>
      <span>Order History</span>
    </.link>

    <.link
      navigate={~p"/kitchen/#{@org.slug}/menu"}
      class={[
        "flex items-center gap-4 px-6 py-4 rounded-2xl font-medium transition-all duration-200 font-headline",
        if(@live_action == :menu,
          do: "bg-white text-primary shadow-sm",
          else: "text-on-surface-variant hover:bg-surface-container hover:translate-x-0.5"
        )
      ]}
    >
      <span class="material-symbols-outlined">edit_note</span>
      <span>Menu Editor</span>
    </.link>

    <.link
      navigate={~p"/kitchen/#{@org.slug}/settings"}
      class={[
        "flex items-center gap-4 px-6 py-4 rounded-2xl font-medium transition-all duration-200 font-headline",
        if(@live_action == :settings,
          do: "bg-white text-primary shadow-sm",
          else: "text-on-surface-variant hover:bg-surface-container hover:translate-x-0.5"
        )
      ]}
    >
      <span class="material-symbols-outlined">manage_accounts</span>
      <span>Settings</span>
    </.link>
  </nav>

  <div class="mt-auto px-4">
    <div class="rounded-xl bg-surface-container p-2 space-y-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined">person</span>
        <span class="text-sm">{@visitor_count} browsing now</span>
      </div>
    </div>
  </div>
</aside>

<div id="kitchen-alert" phx-hook="KitchenAlert" class="hidden"></div>

<main class="ml-72 min-h-screen bg-background">
  <header class="bg-background/90 backdrop-blur-sm sticky top-0 z-30 flex justify-between items-center px-8 py-4">
    <div class="flex items-center gap-4">
      <h1 class="font-headline text-2xl font-black text-primary italic">
        {case @live_action do
          :orders -> "Live Orders"
          :baskets -> "Basket Monitor"
          :history -> "Order History"
          :menu -> "Menu Editor"
          :settings -> "Settings"
        end}
      </h1>
    </div>
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-2 text-sm text-on-surface-variant">
        <span class="material-symbols-outlined text-lg">visibility</span>
        <span class="font-semibold">{@visitor_count}</span>
        <span>on menu</span>
      </div>
    </div>
  </header>

  <%= if @live_action == :orders do %>
    <.live_component
      module={SupervisedSlicesWeb.AdminLive.OrdersComponent}
      id="orders"
      orders={@orders_initial}
      ticket_count={@ticket_count}
      active_carts_count={length(@active_carts)}
      visitor_count={@visitor_count}
      ash_scope={@ash_scope}
      org={@org}
    />
  <% end %>

  <%= if @live_action == :history do %>
    <.live_component
      module={SupervisedSlicesWeb.AdminLive.HistoryComponent}
      id="history"
      ash_scope={@ash_scope}
    />
  <% end %>

  <%= if @live_action == :baskets do %>
    <.live_component
      module={SupervisedSlicesWeb.AdminLive.BasketsComponent}
      id="baskets"
      active_carts={@active_carts}
    />
  <% end %>

  <%= if @live_action == :menu do %>
    <.live_component
      module={SupervisedSlicesWeb.AdminLive.MenuEditorComponent}
      id="menu-editor"
      ash_scope={@ash_scope}
    />
  <% end %>

  <%= if @live_action == :settings do %>
    <.live_component
      module={SupervisedSlicesWeb.AdminLive.SettingsComponent}
      id="settings"
      org={@org}
    />
  <% end %>
</main>

<div class="fixed bottom-20 right-10 opacity-[0.07] pointer-events-none rotate-12 hidden lg:block">
  <span class="material-symbols-outlined text-secondary" style="font-size: 160px;">eco</span>
</div>
