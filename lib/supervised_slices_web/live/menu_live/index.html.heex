<header class="fixed top-0 w-full z-50 bg-[#faf9f6]/80 backdrop-blur-xl flex justify-between items-center px-6 py-4">
  <div class="flex items-center gap-3">
    <h1
      class="text-xl font-bold tracking-tight text-[#E31837]"
      style="font-family: 'Plus Jakarta Sans', sans-serif;"
    >
      {@org.name}
    </h1>
  </div>
  <div class="flex items-center gap-3">
    <button class="text-on-surface-variant hover:scale-105 transition-transform active:scale-95 relative">
      <span class="material-symbols-outlined">shopping_bag</span>
      <%= if @cart_count > 0 do %>
        <span class="absolute -top-1 -right-1 bg-primary text-white text-[10px] font-black rounded-full w-4 h-4 flex items-center justify-center leading-none">
          {@cart_count}
        </span>
      <% end %>
    </button>
  </div>
</header>

<main class="pt-24 pb-36 px-4 max-w-5xl mx-auto">
  <%= for {category, idx} <- Enum.with_index(@categories) do %>
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <div class={[
          "h-8 w-1 rounded-full shrink-0",
          if(rem(idx, 2) == 0, do: "bg-primary", else: "bg-secondary")
        ]}>
        </div>
        <h2
          class="text-2xl font-extrabold tracking-tight text-on-surface"
          style="font-family: 'Plus Jakarta Sans', sans-serif;"
        >
          {category.name}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= for item <- category.menu_items do %>
          <% customizable? =
            not Enum.empty?(item.sizes || []) or not Enum.empty?(item.modifier_groups || []) %>
          <div class="bg-surface-container-lowest rounded-xl p-4 transition-all hover:scale-[1.01] hover:shadow-[0px_12px_32px_rgba(93,63,62,0.08)] flex flex-col gap-4">
            <.link navigate={~p"/menu/#{@org.slug}/item/#{item.id}"} class="flex gap-4 group">
              <div class="relative w-24 h-24 shrink-0 overflow-hidden rounded-lg">
                <img
                  src={item.image_url || "https://placehold.co/96x96/f4f3f1/5d3f3e?text=🍕"}
                  alt={item.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  style={"view-transition-name: item-img-#{item.id};"}
                />
              </div>
              <div class="flex-1 min-w-0">
                <h3
                  class="text-base font-bold leading-snug mb-1 text-on-surface"
                  style="font-family: 'Plus Jakarta Sans', sans-serif;"
                >
                  {item.name}
                </h3>
                <p class="text-sm text-on-surface-variant line-clamp-2 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </.link>

            <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface-container-low">
              <span class="text-sm font-bold text-primary">
                <%= cond do %>
                  <% not Enum.empty?(item.sizes || []) -> %>
                    From {item.sizes
                    |> Enum.min_by(& &1.price.amount)
                    |> then(& &1.price)
                    |> format_money()}
                  <% item.price -> %>
                    {format_money(item.price)}
                  <% true -> %>
                    —
                <% end %>
              </span>
              <%= if customizable? do %>
                <.link
                  navigate={~p"/menu/#{@org.slug}/item/#{item.id}"}
                  class="flex items-center gap-1.5 bg-primary text-white text-xs font-bold px-4 py-2 rounded-full hover:opacity-90 transition-opacity"
                >
                  Customize
                  <span class="material-symbols-outlined" style="font-size: 14px;">
                    arrow_forward
                  </span>
                </.link>
              <% else %>
                <div class="flex items-center bg-white rounded-full p-1 shadow-sm">
                  <button
                    phx-click="update_quantity"
                    phx-value-item_id={item.id}
                    phx-value-delta="-1"
                    class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors"
                    aria-label="Remove one"
                  >
                    <span class="material-symbols-outlined" style="font-size: 18px;">remove</span>
                  </button>
                  <span class="px-2.5 text-sm font-bold min-w-[1.5rem] text-center">
                    {get_item_qty(@cart_items_map, item.id)}
                  </span>
                  <button
                    phx-click="update_quantity"
                    phx-value-item_id={item.id}
                    phx-value-delta="1"
                    class="w-7 h-7 flex items-center justify-center rounded-full bg-primary text-white hover:bg-primary-container transition-colors"
                    aria-label="Add one"
                  >
                    <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= if Enum.empty?(@categories) do %>
    <div class="text-center py-24 text-on-surface-variant">
      <span class="material-symbols-outlined text-6xl opacity-30">restaurant_menu</span>
      <p class="mt-4 text-lg font-medium">Menu coming soon</p>
    </div>
  <% end %>
</main>

<nav class="fixed bottom-6 left-0 right-0 flex justify-center items-center px-4 z-50 pointer-events-none">
  <div class="pointer-events-auto w-[90%] max-w-lg bg-gradient-to-r from-[#b90027] to-[#e31837] rounded-full flex justify-around items-center px-4 py-2 shadow-[0px_12px_32px_rgba(185,0,39,0.25)]">
    <button class="flex items-center gap-2 bg-white/20 rounded-full px-5 py-2.5 text-white font-bold hover:scale-[1.02] transition-all active:scale-95">
      <span class="material-symbols-outlined">restaurant_menu</span>
      <span
        class="text-[10px] uppercase tracking-widest"
        style="font-family: 'Be Vietnam Pro', sans-serif;"
      >
        Explore Menu
      </span>
    </button>
    <button
      phx-click="toggle_basket"
      class="flex items-center gap-1.5 text-white/80 px-5 py-2.5 hover:scale-[1.02] transition-all active:scale-95"
    >
      <span class="material-symbols-outlined">shopping_cart_checkout</span>
      <span
        class="text-[10px] uppercase tracking-widest"
        style="font-family: 'Be Vietnam Pro', sans-serif;"
      >
        View Basket
      </span>
      <%= if @cart_count > 0 do %>
        <span class="ml-1 bg-white text-primary text-[10px] font-black rounded-full w-5 h-5 flex items-center justify-center">
          {@cart_count}
        </span>
      <% end %>
    </button>
  </div>
</nav>

<.basket_drawer cart={@cart} show={@show_basket} checkout_step={@checkout_step} />

<div class="fixed top-[15%] right-[-20px] opacity-10 pointer-events-none transform rotate-45 select-none hidden lg:block text-on-surface">
  <span class="material-symbols-outlined" style="font-size: 120px;">potted_plant</span>
</div>
<div class="fixed bottom-[12%] left-[-20px] opacity-10 pointer-events-none transform -rotate-12 select-none hidden lg:block text-on-surface">
  <span class="material-symbols-outlined" style="font-size: 150px;">cooking</span>
</div>
