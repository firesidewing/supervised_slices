<!-- Hero Section -->
<section class="max-w-[1440px] mx-auto px-8 py-24 md:py-32 grid grid-cols-1 md:grid-cols-12 gap-16 items-center overflow-hidden">
  <div class="md:col-span-6 z-10">
    <p class="font-label text-primary uppercase tracking-[0.2em] text-xs mb-6 font-bold">
      The Digital Atelier for the Modern Pizzaiolo
    </p>
    <h1 class="text-6xl md:text-8xl font-headline font-black text-on-surface leading-[0.95] mb-8 -tracking-[0.04em] text-balance">
      Crafting <span class="text-primary italic">Fire</span> <br />Into Code.
    </h1>
    <p class="text-lg md:text-xl text-on-surface-variant font-body max-w-md mb-10 leading-relaxed opacity-90">
      Bespoke operating systems for artisan pizzerias. From wood-fire temperature telemetry to heritage grain inventory management.
    </p>
    <a
      href="/register"
      class="bg-primary-container text-white px-10 py-5 rounded-md font-body font-bold text-lg hover:shadow-xl transition-all inline-flex items-center gap-3"
    >
      Commission Your OS <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </div>
  <div class="md:col-span-6 relative">
    <div class="relative w-full aspect-[4/5] bg-surface-container-high overflow-hidden rounded-lg shadow-2xl">
      <img
        src="https://images.unsplash.com/photo-1541745537411-b8046dc6d66c?q=80&w=1440&auto=format&fit=crop"
        alt="Artisan pizza making"
        class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000"
      />
    </div>
    <div class="absolute -bottom-12 -left-12 w-64 h-64 bg-secondary-container p-6 rounded-lg shadow-xl hidden md:block">
      <div class="flex flex-col h-full justify-between">
        <span class="material-symbols-outlined text-on-secondary-container text-4xl">
          local_fire_department
        </span>
        <div>
          <p class="font-headline text-3xl font-black text-on-secondary-container">900°F</p>
          <p class="font-label text-xs uppercase tracking-widest text-on-secondary-container opacity-70 font-bold">
            Optimal Heat Profile
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Instruments of Mastery Section -->
<section id="instruments" class="bg-surface-container-low py-32 lg:py-48 px-8">
  <div class="max-w-[1440px] mx-auto">
    <div class="mb-24">
      <h2 class="text-5xl md:text-6xl font-headline font-black mb-6 tracking-tight">
        Instruments of Mastery
      </h2>
      <div class="w-32 h-1.5 bg-primary rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <!-- Kitchen Command Center -->
      <div class="space-y-10 group">
        <div class="aspect-square bg-surface rounded-2xl p-8 shadow-soft border border-outline-variant/10 overflow-hidden relative">
          <div class="h-full w-full bg-surface-container-high rounded-xl p-8 group-hover:scale-105 transition-transform duration-700">
            <div class="flex items-center gap-4 mb-8">
              <div class="w-4 h-4 rounded-full bg-primary animate-pulse"></div>
              <div class="w-20 h-3 bg-on-surface/10 rounded-full"></div>
            </div>
            <div class="space-y-6">
              <div class="h-6 bg-on-surface/5 rounded-lg w-3/4"></div>
              <div class="h-32 bg-on-surface/5 rounded-xl w-full"></div>
              <div class="grid grid-cols-2 gap-6 mt-8">
                <div class="h-16 bg-on-surface/10 rounded-xl"></div>
                <div class="h-16 bg-on-surface/10 rounded-xl"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">Kitchen Command</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            A high-fidelity interface for the line. Managed throughput for wood-fired intensity, ensuring no crust is left behind.
          </p>
        </div>
      </div>
      
<!-- Menu Editor -->
      <div class="space-y-10 md:translate-y-20 group">
        <div class="aspect-square bg-surface rounded-2xl p-8 shadow-soft border border-outline-variant/10 overflow-hidden relative">
          <div class="h-full w-full bg-surface-container-highest rounded-xl p-8 group-hover:scale-105 transition-transform duration-700 flex flex-col justify-end">
            <div class="space-y-4">
              <div class="w-full h-2 bg-primary/20 rounded-full"></div>
              <div class="w-full h-2 bg-primary/20 rounded-full"></div>
              <div class="w-3/4 h-2 bg-primary rounded-full"></div>
            </div>
            <p class="font-label text-[10px] mt-6 opacity-40 font-bold tracking-widest uppercase">
              Editor Mode v2.0
            </p>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Atelier Editor</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            Our visual menu architect. Drag-and-drop seasonal ingredients with real-time food cost telemetry.
          </p>
        </div>
      </div>
      
<!-- Real-time Tracking -->
      <div class="space-y-10 group">
        <div class="aspect-square bg-surface rounded-2xl p-8 shadow-soft border border-outline-variant/10 overflow-hidden relative">
          <div class="h-full w-full bg-secondary-container/20 rounded-xl p-8 group-hover:scale-105 transition-transform duration-700">
            <div class="flex justify-between items-start mb-16">
              <span class="material-symbols-outlined text-5xl text-secondary">monitoring</span>
              <div class="bg-secondary text-white text-[10px] font-bold px-3 py-1 rounded-full tracking-widest">
                LIVE
              </div>
            </div>
            <div class="h-32 w-full flex items-end gap-3">
              <div class="flex-1 bg-secondary/20 h-1/2 rounded-t-lg"></div>
              <div class="flex-1 bg-secondary/40 h-3/4 rounded-t-lg"></div>
              <div class="flex-1 bg-secondary h-full rounded-t-lg"></div>
              <div class="flex-1 bg-secondary/60 h-2/3 rounded-t-lg"></div>
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">Pulse Intelligence</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            Real-time heatmaps of kitchen efficiency and dough maturation cycles across all locations.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Asymmetric Detail Section -->
<section class="py-32 lg:py-64 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-8 grid grid-cols-1 md:grid-cols-12 gap-24 items-center">
    <div class="md:col-span-7 relative">
      <div class="grid grid-cols-2 gap-6">
        <div class="space-y-6">
          <img
            src="https://images.unsplash.com/photo-1590947132387-155cc02f3212?q=80&w=1440&auto=format&fit=crop"
            alt="Dough prep"
            class="w-full aspect-[3/4] object-cover rounded-2xl shadow-xl"
          />
          <div class="bg-primary p-10 rounded-2xl text-white shadow-xl transform -rotate-2">
            <span class="material-symbols-outlined text-5xl mb-6">restaurant_menu</span>
            <h4 class="text-2xl font-headline font-black mb-3">Heritage Inventory</h4>
            <p class="font-body text-sm opacity-90 leading-relaxed">
              Track heirloom grains from farm to oven with origin telemetry.
            </p>
          </div>
        </div>
        <div class="space-y-6 pt-24">
          <div class="bg-surface-container-high aspect-square rounded-2xl flex items-center justify-center p-12 shadow-inner border border-outline-variant/5">
            <div class="text-center">
              <p class="text-6xl font-headline font-black text-on-surface">72h</p>
              <p class="font-label text-xs tracking-widest uppercase mt-4 font-bold opacity-60">
                Fermentation Logic
              </p>
            </div>
          </div>
          <img
            src="https://images.unsplash.com/photo-1574071318508-1cdbad80ad38?q=80&w=1440&auto=format&fit=crop"
            alt="Pizza oven"
            class="w-full aspect-[3/4] object-cover rounded-2xl shadow-xl"
          />
        </div>
      </div>
    </div>
    <div class="md:col-span-5">
      <h2 class="text-5xl md:text-7xl font-headline font-black mb-10 leading-[1.1] tracking-tight">
        The Science of <br /><span class="text-secondary italic">Artisan Precision.</span>
      </h2>
      <p class="text-on-surface-variant font-body text-xl leading-relaxed mb-12 opacity-90">
        We believe that technology should never overshadow the craft. Our interfaces are designed to be invisible—surfacing exactly what the pizzaiolo needs at the moment of firing.
      </p>
      <ul class="space-y-8 font-body text-on-surface text-lg">
        <li class="flex items-center gap-5 group">
          <span class="material-symbols-outlined text-primary text-3xl transition-transform group-hover:scale-110">
            check_circle
          </span>
          <span class="font-bold">Smart Hydration Calculation Engines</span>
        </li>
        <li class="flex items-center gap-5 group">
          <span class="material-symbols-outlined text-primary text-3xl transition-transform group-hover:scale-110">
            check_circle
          </span>
          <span class="font-bold">Predictive Dough Maturity Alerts</span>
        </li>
        <li class="flex items-center gap-5 group">
          <span class="material-symbols-outlined text-primary text-3xl transition-transform group-hover:scale-110">
            check_circle
          </span>
          <span class="font-bold">Automated Supplier Ledger Integration</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- Final CTA Section -->
<section class="max-w-[1280px] mx-auto px-8 mb-48">
  <div class="bg-on-surface rounded-[3rem] p-16 md:p-32 text-center relative overflow-hidden shadow-2xl">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/20 via-transparent to-transparent">
      </div>
    </div>
    <h2 class="text-white text-6xl md:text-8xl font-headline font-black mb-8 relative z-10 tracking-tight leading-none">
      Define Your Legacy.
    </h2>
    <p class="text-white/60 font-body text-xl md:text-2xl max-w-2xl mx-auto mb-16 relative z-10 leading-relaxed">
      The next era of pizzerias will be defined by those who master the data as well as the dough.
    </p>
    <div class="flex flex-col md:flex-row gap-6 justify-center relative z-10">
      <a
        href="/register"
        class="bg-primary text-white px-12 py-6 rounded-xl font-body font-black text-xl hover:bg-primary-container transition-all shadow-xl hover:-translate-y-1"
      >
        Commission Your OS
      </a>
      <a
        href="#"
        class="border-2 border-white/20 text-white px-12 py-6 rounded-xl font-body font-black text-xl hover:bg-white/5 transition-all"
      >
        View The Lookbook
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
