<!-- Hero Section -->
<nav class="absolute top-0 right-0 p-8 z-50 flex gap-6 font-label text-xs tracking-widest uppercase font-black text-on-surface">
  <a
    :if={assigns[:kitchen_org]}
    href={~p"/kitchen/#{@kitchen_org.slug}"}
    class="hover:text-primary transition-colors"
  >
    Kitchen
  </a>
  <a
    :if={assigns[:current_user]}
    href={~p"/sign-out"}
    class="hover:text-primary transition-colors"
  >
    Sign Out
  </a>
  <a
    :if={!assigns[:current_user]}
    href={~p"/sign-in"}
    class="hover:text-primary transition-colors"
  >
    Sign In
  </a>
</nav>
<section class="relative max-w-[1440px] mx-auto px-8 py-24 md:py-32 grid grid-cols-1 md:grid-cols-12 gap-16 items-center overflow-hidden">
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-[radial-gradient(circle,rgba(140,22,26,0.07),transparent_70%)]"></div>
  </div>
  <div class="md:col-span-6 z-10">
    <p class="font-label text-primary uppercase tracking-[0.2em] text-xs mb-6 font-bold">
      The Digital Platform for Pizza Shops
    </p>
    <h1 class="text-6xl md:text-8xl font-headline font-black text-on-surface leading-[0.95] mb-8 -tracking-[0.04em] text-balance">
      Crafting <span class="text-primary italic">Slices</span> <br />Into Business.
    </h1>
    <p class="text-lg md:text-xl text-on-surface-variant font-body max-w-md mb-10 leading-relaxed opacity-90">
      The digital platform for pizza shops. From beautiful online menus to streamlined kitchen operations.
    </p>
    <a
      href="/register"
      class="bg-primary-container text-white px-10 py-5 rounded-md font-body font-bold text-lg hover:shadow-xl transition-all inline-flex items-center gap-3"
    >
      Get Started <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <p class="mt-6 font-label text-xs tracking-widest uppercase text-on-surface-variant opacity-50">
      No commission on orders · No hidden fees
    </p>
  </div>
  <div class="md:col-span-6 relative">
    <div class="relative w-full aspect-[4/5] bg-surface-container-high overflow-hidden rounded-lg shadow-2xl">
      <img
        src="https://images.unsplash.com/photo-1541745537411-b8046dc6d66c?q=80&w=1440&auto=format&fit=crop"
        alt="Pizza making"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="absolute -top-4 -right-4 bg-surface/90 backdrop-blur-xl px-5 py-4 rounded-xl shadow-soft hidden md:flex items-center gap-3 border border-outline-variant/10">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-60"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-secondary"></span>
      </span>
      <p class="font-label text-xs uppercase tracking-widest font-bold text-on-surface">Real-Time Orders</p>
    </div>
    <div class="absolute -bottom-12 -left-12 w-64 h-64 bg-secondary-container p-6 rounded-lg shadow-xl hidden md:block">
      <div class="flex flex-col h-full justify-between">
        <span class="material-symbols-outlined text-on-secondary-container text-4xl">
          local_fire_department
        </span>
        <div>
          <p class="font-headline text-3xl font-black text-on-secondary-container">900°F</p>
          <p class="font-label text-xs uppercase tracking-widest text-on-secondary-container opacity-70 font-bold">
            Optimal Heat Profile
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- The Artisan Toolkit Section -->
<section id="instruments" class="bg-surface-container-low py-32 lg:py-48 px-8">
  <div class="max-w-[1440px] mx-auto">
    <div class="mb-24">
      <h2 class="text-5xl md:text-6xl font-headline font-black mb-6 tracking-tight">
        Your Pizza Shop Toolkit
      </h2>
      <div class="w-32 h-1.5 bg-primary rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <!-- The Rail (Kitchen Management) -->
      <div class="space-y-10 group">
        <div class="aspect-square bg-surface-container-low rounded-2xl shadow-soft border border-outline-variant/10 overflow-hidden max-w-sm mx-auto md:max-w-none">
          <div class="w-full h-full overflow-hidden relative">
            <div
              class="absolute top-0 left-0 pointer-events-none"
              style="transform: scale(0.60); transform-origin: top left; width: 167%; height: 167%;"
            >
              <.order_preview orders={@preview_orders} />
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Rail</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            A real-time view of your kitchen line. Keep orders moving so nothing gets backed up or overcooked.
          </p>
        </div>
      </div>

      <!-- The Studio (Menu Editor) -->
      <div class="space-y-10 md:translate-y-20 group">
        <div class="aspect-square bg-surface rounded-2xl shadow-soft border border-outline-variant/10 overflow-hidden max-w-sm mx-auto md:max-w-none">
          <div class="w-full h-full overflow-hidden relative">
            <div
              class="absolute top-0 left-0 pointer-events-none"
              style="transform: scale(0.45); transform-origin: top left; width: 222%; height: 222%;"
            >
              <.menu_editor_preview items={@preview_editor_items} />
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Studio</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            Easily manage your menu items, specials, ingredients, and customization options in real-time.
          </p>
        </div>
      </div>

      <!-- The Counter (Online Ordering) -->
      <div class="space-y-10 group">
        <div class="aspect-square bg-surface rounded-2xl shadow-soft border border-outline-variant/10 overflow-hidden max-w-sm mx-auto md:max-w-none">
          <div class="w-full h-full overflow-hidden relative">
            <div
              class="absolute top-0 left-0 pointer-events-none"
              style="transform: scale(0.55); transform-origin: top left; width: 182%; height: 182%;"
            >
              <.menu_grid_preview category_name="Pizze" items={@preview_menu_items} />
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Counter</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            Mobile-first online ordering. Fast, easy to use, and designed to get customers to checkout quickly.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Asymmetric Detail Section -->
<section class="py-32 lg:py-64 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-8 grid grid-cols-1 md:grid-cols-12 gap-24 items-center">
    <div class="md:col-span-7 relative">
      <div class="hidden md:grid grid-cols-2 gap-6">
        <div class="space-y-6">
          <img
            src="https://images.unsplash.com/photo-1590947132387-155cc02f3212?q=80&w=1440&auto=format&fit=crop"
            alt="Dough prep"
            class="w-full aspect-[3/4] object-cover rounded-2xl shadow-xl"
          />
          <div class="bg-primary p-6 xl:p-10 rounded-2xl text-white shadow-xl transform -rotate-2">
            <span class="material-symbols-outlined text-5xl mb-6">inventory</span>
            <h4 class="text-2xl font-headline font-black mb-3">Inventory Control</h4>
            <p class="font-body text-sm opacity-90 leading-relaxed">
              Manage your toppings and dough supplies easily.
            </p>
          </div>
        </div>
        <div class="space-y-6 pt-24">
          <div class="bg-surface-container-high aspect-square rounded-2xl p-8 shadow-inner border border-outline-variant/5 flex flex-col justify-center">
            <p class="font-label text-[10px] uppercase tracking-widest font-bold opacity-50 mb-8">Today's Kitchen</p>
            <div class="space-y-6">
              <div>
                <p class="font-headline font-black text-5xl text-on-surface">34</p>
                <p class="font-label text-[10px] uppercase tracking-widest opacity-50 mt-1">Orders Today</p>
              </div>
              <div class="w-full h-px bg-on-surface/5"></div>
              <div>
                <p class="font-headline font-black text-5xl text-secondary">12<span class="text-3xl"> min</span></p>
                <p class="font-label text-[10px] uppercase tracking-widest opacity-50 mt-1">Avg. Prep Time</p>
              </div>
              <div class="w-full h-px bg-on-surface/5"></div>
              <div>
                <p class="font-headline font-black text-5xl text-on-surface">$1,840</p>
                <p class="font-label text-[10px] uppercase tracking-widest opacity-50 mt-1">Revenue</p>
              </div>
            </div>
          </div>
          <img
            src="https://images.unsplash.com/photo-1574071318508-1cdbad80ad38?q=80&w=1440&auto=format&fit=crop"
            alt="Pizza oven"
            class="w-full aspect-[3/4] object-cover rounded-2xl shadow-xl"
          />
        </div>
      </div>
    </div>
    <div class="md:col-span-5">
      <h2 class="text-5xl md:text-7xl font-headline font-black mb-10 leading-[1.1] tracking-tight">
        Running a Great <br /><span class="text-secondary italic">Shop.</span>
      </h2>
      <p class="text-on-surface-variant font-body text-xl leading-relaxed mb-12 opacity-90">
        We keep things simple. No confusing features — just the tools you need to run your shop, day in and day out.
      </p>
      <ul class="space-y-8 font-body text-on-surface text-lg">
        <li class="flex items-center gap-5 group">
          <span class="material-symbols-outlined text-primary text-3xl transition-transform group-hover:scale-110">
            check_circle
          </span>
          <span class="font-bold">Mobile-Optimized Ordering Experience</span>
        </li>
        <li class="flex items-center gap-5 group">
          <span class="material-symbols-outlined text-primary text-3xl transition-transform group-hover:scale-110">
            check_circle
          </span>
          <span class="font-bold">Live Kitchen Order Management</span>
        </li>
        <li class="flex items-center gap-5 group">
          <span class="material-symbols-outlined text-primary text-3xl transition-transform group-hover:scale-110">
            check_circle
          </span>
          <span class="font-bold">Customer Growth & Analytics</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- Pricing Section -->
<section id="pricing" class="py-32 lg:py-48 px-8 bg-surface">
  <div class="max-w-[1440px] mx-auto">
    <div class="text-center mb-24">
      <h2 class="text-5xl md:text-7xl font-headline font-black mb-6 tracking-tight">
        Simple <span class="text-primary italic">Pricing.</span>
      </h2>
      <p class="text-on-surface-variant font-body text-xl max-w-2xl mx-auto opacity-90">
        No per-order commissions. No hidden fees. Cancel anytime.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto mb-24">
      <!-- Base Dough Tier -->
      <div class="bg-surface-container-low p-12 rounded-[2rem] border border-outline-variant/10 flex flex-col hover:shadow-xl transition-all duration-500 group">
        <div class="mb-8">
          <h3 class="font-headline text-3xl font-black mb-2">Starter</h3>
          <p class="text-on-surface-variant font-body">
            Everything you need to get up and running.
          </p>
        </div>
        <div class="mb-10">
          <span class="text-5xl font-headline font-black">$49</span>
          <span class="text-on-surface-variant font-body">/month</span>
          <p class="text-on-surface-variant/60 font-label text-xs uppercase tracking-widest mt-2">or $39/mo billed annually</p>
        </div>
        <ul class="space-y-6 mb-12 flex-grow">
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-secondary font-bold">check</span>
            Online Ordering ("The Counter")
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-secondary font-bold">check</span>
            Menu Studio ("The Studio")
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-secondary font-bold">check</span>
            Kitchen Command ("The Rail")
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-secondary font-bold">check</span>
            Live Order Tracking
          </li>
        </ul>
        <a
          href="/register"
          class="w-full py-5 bg-on-surface text-white rounded-xl font-body font-black text-center hover:bg-primary transition-colors"
        >
          Start free 14-day trial
        </a>
      </div>
      
<!-- Pro Crust Tier -->
      <div class="bg-on-surface p-12 rounded-[2rem] text-white flex flex-col shadow-2xl transform md:-translate-y-4 hover:-translate-y-6 transition-all duration-500 relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-primary text-white px-6 py-2 font-label text-xs font-black tracking-widest uppercase rounded-bl-xl">
          Recommended
        </div>
        <div class="mb-8">
          <h3 class="font-headline text-3xl font-black mb-2">Pro</h3>
          <p class="text-white/60 font-body">Everything you need to run and grow.</p>
        </div>
        <div class="mb-10">
          <span class="text-5xl font-headline font-black">$129</span>
          <span class="text-white/60 font-body">/month</span>
          <p class="text-white/40 font-label text-xs uppercase tracking-widest mt-2">or $103/mo billed annually</p>
        </div>
        <ul class="space-y-6 mb-12 flex-grow">
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-primary font-bold">check</span>
            Everything in Starter
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-primary font-bold">check</span>
            Order History & Detailed Analytics
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-primary font-bold">check</span>
            Marketing & Upselling Tools
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-primary font-bold">check</span>
            Dedicated Onboarding Support
          </li>
          <li class="flex items-center gap-4 font-body text-lg">
            <span class="material-symbols-outlined text-primary font-bold">check</span>
            Priority Support
          </li>
        </ul>
        <a
          href="/register"
          class="w-full py-5 bg-primary text-white rounded-xl font-body font-black text-center hover:bg-primary-container transition-colors shadow-lg"
        >
          Try Pro free for 14 days
        </a>
      </div>
    </div>

    <div class="max-w-5xl mx-auto mb-16 flex flex-wrap justify-center gap-3">
      <span class="bg-secondary-container text-on-secondary-container font-label text-xs px-4 py-2 rounded-full font-bold tracking-wide">
        ✓ No commission per order
      </span>
      <span class="bg-secondary-container text-on-secondary-container font-label text-xs px-4 py-2 rounded-full font-bold tracking-wide">
        vs. Slice's 5% per-order fee
      </span>
      <span class="bg-secondary-container text-on-secondary-container font-label text-xs px-4 py-2 rounded-full font-bold tracking-wide">
        vs. Owner.com's $249/mo
      </span>
    </div>

<!-- Concierge Add-on -->
    <div class="max-w-3xl mx-auto bg-surface-container-high p-8 md:p-12 rounded-[2rem] border border-outline-variant/10 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h3 class="font-headline text-2xl font-black mb-2">Menu Import Concierge</h3>
        <p class="text-on-surface-variant font-body max-w-md">
          Don't have time to build your menu from scratch? We'll import everything from your existing menu or PDFs — a completely optional one-time service.
        </p>
      </div>
      <div class="text-center md:text-right min-w-[200px]">
        <span class="text-4xl font-headline font-black">$150</span>
        <p class="text-on-surface-variant font-body text-sm mb-4">Optional Add-On</p>
        <a
          href="/register"
          class="inline-block px-8 py-3 bg-secondary text-white rounded-xl font-body font-black text-sm hover:opacity-90 transition-opacity"
        >
          Add On
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA Section -->
<section class="max-w-[1280px] mx-auto px-8 mb-48">
  <div class="bg-on-surface rounded-[3rem] p-16 md:p-32 text-center relative overflow-hidden shadow-2xl">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/20 via-transparent to-transparent">
      </div>
    </div>
    <h2 class="text-white text-6xl md:text-8xl font-headline font-black mb-8 relative z-10 tracking-tight leading-none">
      Start Running Your Shop Smarter.
    </h2>
    <p class="text-white/60 font-body text-xl md:text-2xl max-w-2xl mx-auto mb-16 relative z-10 leading-relaxed">
      Better tools mean fewer headaches and more time doing what you do best — making great pizza.
    </p>
    <div class="flex flex-col md:flex-row gap-6 justify-center relative z-10">
      <a
        href="/register"
        class="bg-primary text-white px-12 py-6 rounded-xl font-body font-black text-xl hover:bg-primary-container transition-all shadow-xl hover:-translate-y-1"
      >
        Get Started
      </a>
      <a
        href="#instruments"
        class="border-2 border-white/20 text-white px-12 py-6 rounded-xl font-body font-black text-xl hover:bg-white/5 transition-all"
      >
        See How It Works
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-surface-container-low w-full py-24 px-8 border-t border-outline-variant/10">
  <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row justify-between items-center gap-12">
    <div class="font-headline text-3xl font-black tracking-tighter text-on-surface">
      Basil & Stone
    </div>
    <nav class="flex flex-wrap justify-center gap-12 font-label text-sm tracking-widest uppercase font-black opacity-60">
      <a class="hover:text-primary transition-colors" href="#">Sustainability</a>
      <a class="hover:text-primary transition-colors" href="#">Sourcing</a>
      <a
        class="hover:text-primary transition-colors font-black text-on-surface opacity-100"
        href="#"
      >
        Blog
      </a>
      <a class="hover:text-primary transition-colors" href="#">Privacy</a>
    </nav>
    <div class="text-primary text-xs font-label font-black tracking-widest opacity-80 uppercase">
      © {DateTime.utc_now().year} Basil & Stone. The Digital Platform for Pizza Shops.
    </div>
  </div>
</footer>
