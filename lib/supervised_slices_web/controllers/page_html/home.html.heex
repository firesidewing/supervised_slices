<!-- Pain Section -->
<section class="py-24 lg:py-40 px-8 bg-surface-container-low">
  <div class="max-w-[1440px] mx-auto">
    <div class="mb-16 max-w-2xl">
      <p class="font-label text-primary uppercase tracking-[0.2em] text-xs mb-6 font-bold">
        The Reality
      </p>
      <h2 class="text-5xl md:text-6xl font-headline font-black mb-6 tracking-tight">
        Sound familiar?
      </h2>
      <p class="text-on-surface-variant font-body text-xl leading-relaxed">
        Independent pizza shops are running great food on broken systems.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-5xl">
      <div class="bg-surface-container p-8 rounded-[1.5rem]">
        <span class="material-symbols-outlined text-primary text-4xl mb-6 block">phone_callback</span>
        <h3 class="font-headline font-black text-2xl mb-3">Phone orders eating your night</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Half your staff tied up taking calls, reading back toppings, and re-explaining the menu.
        </p>
      </div>
      <div class="bg-surface-container p-8 rounded-[1.5rem]">
        <span class="material-symbols-outlined text-primary text-4xl mb-6 block">receipt_long</span>
        <h3 class="font-headline font-black text-2xl mb-3">Paying Slice 5% of every order</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          That's $500 off every $10,000 in sales — gone before you've paid a single bill.
        </p>
      </div>
      <div class="bg-surface-container p-8 rounded-[1.5rem]">
        <span class="material-symbols-outlined text-primary text-4xl mb-6 block">visibility_off</span>
        <h3 class="font-headline font-black text-2xl mb-3">Tickets getting lost in the rush</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Paper tickets, shouted orders, missed modifiers. The kitchen falls behind and customers blame you.
        </p>
      </div>
      <div class="bg-surface-container p-8 rounded-[1.5rem]">
        <span class="material-symbols-outlined text-primary text-4xl mb-6 block">build</span>
        <h3 class="font-headline font-black text-2xl mb-3">A different tool for everything</h3>
        <p class="font-body text-on-surface-variant leading-relaxed">
          Online ordering here, kitchen display there, menu edits somewhere else. Nothing talks to each other.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Toolkit Section -->
<section id="instruments" class="bg-surface-container-low py-32 lg:py-48 px-8">
  <div class="max-w-[1440px] mx-auto">
    <div class="mb-24">
      <h2 class="text-5xl md:text-6xl font-headline font-black mb-6 tracking-tight">
        Your Pizza Shop Toolkit
      </h2>
      <div class="w-32 h-1.5 bg-primary rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <!-- The Rail (Kitchen Management) -->
      <div class="space-y-10 group">
        <div class="aspect-square bg-surface-container-low rounded-2xl shadow-soft border border-outline-variant/10 overflow-hidden max-w-sm mx-auto md:max-w-none">
          <div class="w-full h-full overflow-hidden relative">
            <div
              class="absolute top-0 left-0 pointer-events-none"
              style="transform: scale(0.60); transform-origin: top left; width: 167%; height: 167%;"
            >
              <.order_preview orders={@preview_orders} />
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Rail</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            See every order the moment it comes in. Staff know what's up next without checking a screen twice — nothing gets lost, nothing backs up.
          </p>
        </div>
      </div>

      <!-- The Studio (Menu Editor) -->
      <div class="space-y-10 md:translate-y-20 group">
        <div class="aspect-square bg-surface rounded-2xl shadow-soft border border-outline-variant/10 overflow-hidden max-w-sm mx-auto md:max-w-none">
          <div class="w-full h-full overflow-hidden relative">
            <div
              class="absolute top-0 left-0 pointer-events-none"
              style="transform: scale(0.45); transform-origin: top left; width: 222%; height: 222%;"
            >
              <.menu_editor_preview items={@preview_editor_items} />
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Studio</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            Update prices, add items, change toppings. Your menu goes live the moment you hit save — no calling support, no waiting overnight.
          </p>
        </div>
      </div>

      <!-- The Counter (Online Ordering) -->
      <div class="space-y-10 group">
        <div class="aspect-square bg-surface rounded-2xl shadow-soft border border-outline-variant/10 overflow-hidden max-w-sm mx-auto md:max-w-none">
          <div class="w-full h-full overflow-hidden relative">
            <div
              class="absolute top-0 left-0 pointer-events-none"
              style="transform: scale(0.55); transform-origin: top left; width: 182%; height: 182%;"
            >
              <.basket_preview item={@preview_counter_item} />
            </div>
          </div>
        </div>
        <div class="px-2">
          <h3 class="text-3xl font-headline font-black mb-4">The Counter</h3>
          <p class="font-body text-on-surface-variant leading-relaxed text-lg">
            Customers open a link, order in under a minute. No app to download. No Slice. No Uber Eats taking a cut. Every dollar comes to you.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

