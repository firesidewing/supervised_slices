# Stripe API Secret Key (sk_...)
STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret (whsec_...)
# Find this in the Stripe Dashboard under Developers > Webhooks
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs
# Create these in the Stripe Dashboard under Products
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MENU_UPLOAD=

# Database configuration
DATABASE_URL=ecto://postgres:postgres@localhost/supervised_slices_dev

# Phoenix signing secret
SECRET_KEY_BASE=

# Token signing secret (for user invites, etc.)
TOKEN_SIGNING_SECRET=
